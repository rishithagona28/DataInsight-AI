# Copy this file to ".env" and fill in your real key. Get a free key (no
# credit card required) from Google AI Studio: https://aistudio.google.com/apikey
# Never commit the real ".env" file, and never put the key anywhere the
# browser/frontend could read it. Every AI call in this app runs
# server-side (see modules/insights.py and modules/chat_agent.py); the key
# is read once here via os.environ and is never returned in any response
# sent to the page.
GEMINI_API_KEY=

# Optional: which models to use, in order. When one hits its free daily
# limit, the app automatically moves on to the next (each model has its own
# quota). Leave unset to use the built-in chain in modules/llm.py.
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest

# Advanced, optional: point at a different OpenAI-compatible endpoint
# (Groq, OpenRouter, a local Ollama server, etc.) instead of Gemini —
# set this plus GEMINI_API_KEY/GEMINI_MODEL to that provider's values, no
# code changes needed. Leave unset to use Gemini.
# LLM_BASE_URL=https://api.groq.com/openai/v1
